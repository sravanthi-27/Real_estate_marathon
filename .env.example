# ---- Supabase (server only - never expose the service role key) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=registration-docs

# ---- Payments: demo for local development; production requires razorpay ----
PAYMENT_PROVIDER=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Public site config ----
NEXT_PUBLIC_EVENT_DATE=2026-12-20T05:00:00+05:30
NEXT_PUBLIC_MAP_EMBED_URL=
